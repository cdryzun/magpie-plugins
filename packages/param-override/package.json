{
  "name": "@magpie-community/middleware-param-override",
  "version": "0.1.0",
  "description": "New API's param_override (参数覆盖) as magpie gateway middleware: set, delete, move and rewrite any field of what agents send, with conditions",
  "type": "module",
  "files": ["param-override.middleware.js", "README.md"],
  "keywords": ["magpie", "magpie-middleware", "new-api", "param-override", "llm-gateway"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/magpie-community/plugins.git", "directory": "packages/param-override" },
  "magpie": {
    "middleware": "./param-override.middleware.js",
    "options": {
      "operations": [
        { "path": "max_tokens", "mode": "set", "value": 32000, "conditions": [{ "path": "max_tokens", "mode": "gt", "value": 32000 }] },
        { "path": "temperature", "mode": "delete", "conditions": [{ "path": "model", "mode": "contains", "value": "reasoner" }] }
      ]
    }
  }
}
