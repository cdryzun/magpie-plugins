{
  "name": "@magpie-community/middleware-model-map",
  "version": "0.1.1",
  "description": "New API's model_mapping (模型重定向) as magpie gateway middleware: send the model an agent asks for as another, and keep the asked name in replies",
  "type": "module",
  "files": ["model-map.middleware.js", "README.md"],
  "keywords": ["magpie", "magpie-middleware", "new-api", "model-mapping", "llm-gateway"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/magpie-community/plugins.git", "directory": "packages/model-map" },
  "magpie": {
    "middleware": "./model-map.middleware.js",
    "options": { "mapping": { "fast": "deepseek-chat", "/^gpt-4o(-.*)?$/": "deepseek-chat" } }
  }
}
